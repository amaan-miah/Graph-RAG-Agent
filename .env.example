# Neo4j Aura (https://console.neo4j.io)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Kimchi (https://kimchi.dev) - OpenAI-compatible LLM hub on CAST AI infra
# API key from kimchi.dev (starts with "castai_v1_")
KIMCHI_API_KEY=your-kimchi-key-here
KIMCHI_BASE_URL=https://llm.cast.ai/openai/v1
# Models available at time of writing: kimi-k2.6, kimi-k2.5, minimax-m2.7,
# minimax-m2.5, qwen3-coder-next-fp8, nemotron-3-super-fp4, smollm2-360m, smollm2-135m
KIMCHI_MODEL=kimi-k2.6
